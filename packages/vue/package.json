{
  "name": "@flagward/vue",
  "version": "0.1.0",
  "description": "Vue SDK for Flagward - Feature Flags as a Service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/sync-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build --prefix ../core && npm run lint && npm run test:run && npm run build"
  },
  "keywords": [
    "feature-flags",
    "flags",
    "vue",
    "sdk",
    "flagward"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basb7/flagward-sdk-js.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/basb7/flagward-sdk-js/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/basb7/flagward-sdk-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flagward/core": "^0.1.0"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
