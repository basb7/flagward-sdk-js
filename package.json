{
  "name": "flagward-sdk-js",
  "private": true,
  "description": "Flagward SDKs for JavaScript: a shared core and one thin adapter per framework",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "prelint": "npm run build -w @flagward/core",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "npm run build -w @flagward/core",
    "test": "npm run test:run --workspaces --if-present"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basb7/flagward-sdk-js.git"
  },
  "homepage": "https://github.com/basb7/flagward-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/basb7/flagward-sdk-js/issues"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
